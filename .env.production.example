# Modelo: complete os campos vazios usando o gerenciador de segredos do servidor.
# Preserve APP_KEY de instalações existentes (também protege os jobs criptografados).
APP_NAME=Spot
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Necessária para API de estoque/autenticação por token; preserve em atualizações.
JWT_SECRET=
APP_URL=https://spot.seudominio.com
APP_DOMAIN=spot.seudominio.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SEARCH_PATH=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Somente no provisionamento inicial aprovado; não executar seed a cada deploy.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Python com requirements.txt instalado, usado nos relatórios.
PYTHON_BINARY=

# Recursos externos: configure e valide apenas os que serão oferecidos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
CHAT_TRANSLATION_URL=
CHAT_TRANSLATION_KEY=
SPOT_ACTIVITY_EMAIL_ENABLED=false
AUDIT_RETENTION_DAYS=365
